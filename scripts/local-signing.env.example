# From the repository root, copy this file to .swift-rdp.local.env, run chmod
# 600 on the copy, and keep it untracked.
# The install script discovers the first Apple Development identity when
# SWIFTRDP_SIGN_IDENTITY is omitted.

# Optional: pin the exact certificate used for local builds.
# export SWIFTRDP_SIGN_IDENTITY='Apple Development: Your Name (TEAMID)'

# Optional: pin the Team ID so macOS TCC permissions survive app updates.
# export SWIFTRDP_EXPECTED_TEAM_ID='TEAMID'

# Optional: use a non-default local keychain path.
# export SWIFTRDP_KEYCHAIN_PATH="$HOME/Library/Keychains/login.keychain-db"
